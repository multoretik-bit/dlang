[
{"p": "Hi! How are you?", "t": "Привет! Как дела?", "note": "Стандартное приветствие; отвечают коротко: Good, thanks!", "cat": "greetings", "lvl": "A1"},
{"p": "Hey!", "t": "Привет!", "note": "Самое частое неформальное приветствие среди друзей и коллег.", "cat": "greetings", "lvl": "A1"},
{"p": "Good morning!", "t": "Доброе утро!", "note": "До полудня; подходит и для работы, и для незнакомых.", "cat": "greetings", "lvl": "A1"},
{"p": "Good evening!", "t": "Добрый вечер!", "note": "Только при встрече. Good night — это «спокойной ночи».", "cat": "greetings", "lvl": "A1"},
{"p": "Good night!", "t": "Спокойной ночи!", "note": "Только при прощании вечером или перед сном.", "cat": "greetings", "lvl": "A1"},
{"p": "Nice to see you again.", "t": "Рад снова тебя видеть.", "note": "Когда уже знакомы. При первой встрече — Nice to meet you.", "cat": "greetings", "lvl": "A2"},
{"p": "Long time no see!", "t": "Сколько лет, сколько зим!", "note": "Разговорно, когда давно не виделись.", "cat": "greetings", "lvl": "A2"},
{"p": "Bye! See you later.", "t": "Пока! Увидимся.", "note": "Говорят, даже если следующая встреча не скоро.", "cat": "greetings", "lvl": "A1"},
{"p": "See you tomorrow!", "t": "До завтра!", "note": "", "cat": "greetings", "lvl": "A1"},
{"p": "Take care!", "t": "Береги себя! Всего доброго!", "note": "Тёплое и очень частое прощание.", "cat": "greetings", "lvl": "A2"},
{"p": "Have a nice day!", "t": "Хорошего дня!", "note": "Говорят продавцы, коллеги, знакомые. Ответ: You too!", "cat": "greetings", "lvl": "A1"},
{"p": "Have a good weekend!", "t": "Хороших выходных!", "note": "Обычное прощание в пятницу на работе или в учёбе.", "cat": "greetings", "lvl": "A1"},
{"p": "Catch you later!", "t": "Ещё увидимся!", "note": "Разговорно, между друзьями.", "cat": "greetings", "lvl": "B1"},
{"p": "I've got to go.", "t": "Мне пора.", "note": "В быстрой речи звучит как I gotta go.", "cat": "greetings", "lvl": "A2"},
{"p": "Say hi to your mum for me.", "t": "Передавай привет маме.", "note": "Mum — британское; в США говорят mom.", "cat": "greetings", "lvl": "A2"},
{"p": "It was great seeing you.", "t": "Было здорово увидеться.", "note": "Говорят при прощании после встречи.", "cat": "greetings", "lvl": "A2"},

{"p": "How's it going?", "t": "Как дела? Как жизнь?", "note": "Разговорный вариант How are you?, между друзьями.", "cat": "smalltalk", "lvl": "A1"},
{"p": "What's up?", "t": "Как оно? Что нового?", "note": "Очень разговорно; отвечают Not much или Nothing much.", "cat": "smalltalk", "lvl": "A2"},
{"p": "Not much, you?", "t": "Да ничего особенного, а у тебя?", "note": "Типичный ответ на What's up?", "cat": "smalltalk", "lvl": "A2"},
{"p": "I'm good, thanks. And you?", "t": "Хорошо, спасибо. А ты?", "note": "Самый обычный ответ на How are you?", "cat": "smalltalk", "lvl": "A1"},
{"p": "Not bad.", "t": "Неплохо.", "note": "Нейтральный ответ, звучит вполне позитивно.", "cat": "smalltalk", "lvl": "A1"},
{"p": "Can't complain.", "t": "Грех жаловаться.", "note": "Значит «всё нормально, даже хорошо».", "cat": "smalltalk", "lvl": "B1"},
{"p": "How was your weekend?", "t": "Как прошли выходные?", "note": "Классический вопрос коллегам в понедельник.", "cat": "smalltalk", "lvl": "A2"},
{"p": "What have you been up to?", "t": "Чем занимался в последнее время?", "note": "Когда давно не виделись.", "cat": "smalltalk", "lvl": "B1"},
{"p": "Same as usual.", "t": "Да всё как обычно.", "note": "", "cat": "smalltalk", "lvl": "A2"},
{"p": "Lovely weather today, isn't it?", "t": "Чудесная погода сегодня, правда?", "note": "Типичный британский small talk; lovely — очень британское слово.", "cat": "smalltalk", "lvl": "A2"},
{"p": "It's freezing today!", "t": "Сегодня жуткий холод!", "note": "Freezing — «очень холодно», не обязательно ниже нуля.", "cat": "smalltalk", "lvl": "A2"},
{"p": "How's work?", "t": "Как работа?", "note": "", "cat": "smalltalk", "lvl": "A1"},
{"p": "Busy day?", "t": "Много дел сегодня?", "note": "Короткий дружеский вопрос коллеге или знакомому.", "cat": "smalltalk", "lvl": "A2"},
{"p": "Any plans for the weekend?", "t": "Есть планы на выходные?", "note": "", "cat": "smalltalk", "lvl": "A2"},
{"p": "How's your family doing?", "t": "Как твои родные?", "note": "", "cat": "smalltalk", "lvl": "A2"},

{"p": "My name is Anna.", "t": "Меня зовут Анна.", "note": "В разговоре чаще просто I'm Anna.", "cat": "intro", "lvl": "A1"},
{"p": "What's your name?", "t": "Как тебя зовут?", "note": "", "cat": "intro", "lvl": "A1"},
{"p": "Nice to meet you.", "t": "Приятно познакомиться.", "note": "Ответ: Nice to meet you too.", "cat": "intro", "lvl": "A1"},
{"p": "Where are you from?", "t": "Откуда ты?", "note": "", "cat": "intro", "lvl": "A1"},
{"p": "I'm from Russia.", "t": "Я из России.", "note": "", "cat": "intro", "lvl": "A1"},
{"p": "I live in Moscow.", "t": "Я живу в Москве.", "note": "", "cat": "intro", "lvl": "A1"},
{"p": "What do you do?", "t": "Кем ты работаешь?", "note": "Вопрос о профессии, а не о том, что делаешь сейчас.", "cat": "intro", "lvl": "A2"},
{"p": "I work in IT.", "t": "Я работаю в IT.", "note": "", "cat": "intro", "lvl": "A2"},
{"p": "I'm a student.", "t": "Я студент.", "note": "", "cat": "intro", "lvl": "A1"},
{"p": "This is my friend Max.", "t": "Это мой друг Макс.", "note": "Так представляют одного человека другому.", "cat": "intro", "lvl": "A1"},
{"p": "Have we met before?", "t": "Мы раньше не встречались?", "note": "", "cat": "intro", "lvl": "A2"},
{"p": "How do you two know each other?", "t": "Откуда вы друг друга знаете?", "note": "Частый вопрос на вечеринке.", "cat": "intro", "lvl": "B1"},
{"p": "Sorry, what was your name again?", "t": "Простите, напомните, как вас зовут?", "note": "Вежливо, если забыли имя.", "cat": "intro", "lvl": "A2"},
{"p": "I've heard a lot about you.", "t": "Много о тебе слышал.", "note": "Говорят при знакомстве с другом друга, родственником.", "cat": "intro", "lvl": "B1"},
{"p": "Call me Alex.", "t": "Зови меня Алекс.", "note": "Когда предлагают короткое имя или переход на «ты».", "cat": "intro", "lvl": "A2"},

{"p": "Thank you so much!", "t": "Большое спасибо!", "note": "", "cat": "polite", "lvl": "A1"},
{"p": "Thanks, I really appreciate it.", "t": "Спасибо, очень ценю.", "note": "Когда благодарят за реальную помощь или услугу.", "cat": "polite", "lvl": "B1"},
{"p": "You're welcome.", "t": "Пожалуйста. Не за что.", "note": "Ответ на спасибо; на просьбу так не говорят.", "cat": "polite", "lvl": "A1"},
{"p": "No problem.", "t": "Без проблем. Не за что.", "note": "Разговорный ответ на спасибо или на просьбу.", "cat": "polite", "lvl": "A1"},
{"p": "Don't mention it.", "t": "Не стоит благодарности.", "note": "", "cat": "polite", "lvl": "A2"},
{"p": "Excuse me.", "t": "Извините.", "note": "Чтобы привлечь внимание, пройти или задать вопрос.", "cat": "polite", "lvl": "A1"},
{"p": "Sorry!", "t": "Ой, извините!", "note": "Когда уже виноват: толкнул, перебил, наступил.", "cat": "polite", "lvl": "A1"},
{"p": "I'm so sorry.", "t": "Мне очень жаль. Простите, пожалуйста.", "note": "Серьёзное извинение или сочувствие.", "cat": "polite", "lvl": "A1"},
{"p": "Sorry I'm late.", "t": "Извините за опоздание.", "note": "", "cat": "polite", "lvl": "A2"},
{"p": "Sorry to bother you.", "t": "Извините за беспокойство.", "note": "Перед просьбой к незнакомому или занятому человеку.", "cat": "polite", "lvl": "A2"},
{"p": "Yes, please.", "t": "Да, пожалуйста.", "note": "Просто Yes на предложение звучит резковато.", "cat": "polite", "lvl": "A1"},
{"p": "No, thank you.", "t": "Нет, спасибо.", "note": "Вежливый отказ; разговорно — No, thanks.", "cat": "polite", "lvl": "A1"},
{"p": "After you.", "t": "Проходите. Только после вас.", "note": "Пропуская человека в дверь или в очереди.", "cat": "polite", "lvl": "A2"},
{"p": "Bless you!", "t": "Будь здоров!", "note": "Когда кто-то чихнул.", "cat": "polite", "lvl": "A2"},
{"p": "Pardon?", "t": "Простите, что вы сказали?", "note": "Если не расслышали; в США чаще Sorry? или Excuse me?", "cat": "polite", "lvl": "A2"},
{"p": "That's very kind of you.", "t": "Очень любезно с вашей стороны.", "note": "Вежливо, слегка формально.", "cat": "polite", "lvl": "B1"},

{"p": "Could you help me, please?", "t": "Не могли бы вы мне помочь?", "note": "", "cat": "requests", "lvl": "A1"},
{"p": "Can I ask you something?", "t": "Можно вопрос?", "note": "", "cat": "requests", "lvl": "A1"},
{"p": "Could you say that again?", "t": "Повторите, пожалуйста.", "note": "", "cat": "requests", "lvl": "A2"},
{"p": "Could you speak a bit more slowly?", "t": "Говорите помедленнее, пожалуйста.", "note": "", "cat": "requests", "lvl": "A2"},
{"p": "What does this mean?", "t": "Что это значит?", "note": "", "cat": "requests", "lvl": "A1"},
{"p": "How do you say that in English?", "t": "Как это сказать по-английски?", "note": "", "cat": "requests", "lvl": "A1"},
{"p": "Do you mind if I sit here?", "t": "Вы не против, если я сяду здесь?", "note": "Ответ No, go ahead значит «не против, садитесь».", "cat": "requests", "lvl": "B1"},
{"p": "Can you do me a favour?", "t": "Можешь сделать мне одолжение?", "note": "Favour — британское написание; в США favor.", "cat": "requests", "lvl": "A2"},
{"p": "Would you mind opening the window?", "t": "Вы не могли бы открыть окно?", "note": "Очень вежливо; после mind глагол с -ing.", "cat": "requests", "lvl": "B1"},
{"p": "Can I borrow your pen?", "t": "Можно взять твою ручку?", "note": "Borrow — взять на время.", "cat": "requests", "lvl": "A2"},
{"p": "Is it okay if I leave early?", "t": "Ничего, если я уйду пораньше?", "note": "", "cat": "requests", "lvl": "A2"},
{"p": "Where's the toilet?", "t": "Где туалет?", "note": "Британский вариант; в США говорят restroom или bathroom.", "cat": "requests", "lvl": "A1"},
{"p": "Could you show me on the map?", "t": "Покажите на карте, пожалуйста.", "note": "", "cat": "requests", "lvl": "A2"},
{"p": "Do you know what time it is?", "t": "Не подскажете, который час?", "note": "", "cat": "requests", "lvl": "A2"},
{"p": "Can you give me a hand?", "t": "Поможешь?", "note": "Разговорно, обычно про физическую помощь: донести, подержать.", "cat": "requests", "lvl": "B1"},

{"p": "I think so.", "t": "Думаю, да.", "note": "", "cat": "opinion", "lvl": "A1"},
{"p": "I don't think so.", "t": "Не думаю. Вряд ли.", "note": "По-английски не говорят I think not в обычной речи.", "cat": "opinion", "lvl": "A1"},
{"p": "I agree.", "t": "Согласен.", "note": "Не I am agree — это частая ошибка.", "cat": "opinion", "lvl": "A1"},
{"p": "What do you think?", "t": "Как ты думаешь?", "note": "Не How do you think — это частая ошибка.", "cat": "opinion", "lvl": "A1"},
{"p": "You're right.", "t": "Ты прав.", "note": "", "cat": "opinion", "lvl": "A1"},
{"p": "Exactly!", "t": "Именно! Точно!", "note": "", "cat": "opinion", "lvl": "A2"},
{"p": "I'm not sure.", "t": "Я не уверен.", "note": "", "cat": "opinion", "lvl": "A1"},
{"p": "It depends.", "t": "Смотря как. Зависит от ситуации.", "note": "", "cat": "opinion", "lvl": "A2"},
{"p": "In my opinion, it's too expensive.", "t": "По-моему, это слишком дорого.", "note": "", "cat": "opinion", "lvl": "A2"},
{"p": "To be honest, I don't like it.", "t": "Честно говоря, мне не нравится.", "note": "To be honest часто смягчает критику.", "cat": "opinion", "lvl": "A2"},
{"p": "That makes sense.", "t": "Логично. Понятно.", "note": "Значит «теперь ясно, звучит разумно».", "cat": "opinion", "lvl": "B1"},
{"p": "Fair enough.", "t": "Справедливо. Ну, резонно.", "note": "Принимаешь чужой довод, даже если сначала думал иначе.", "cat": "opinion", "lvl": "B1"},
{"p": "Good point.", "t": "Верно подмечено.", "note": "", "cat": "opinion", "lvl": "B1"},
{"p": "I see your point, but I disagree.", "t": "Понимаю тебя, но я не согласен.", "note": "Вежливое несогласие.", "cat": "opinion", "lvl": "B1"},
{"p": "That's not what I meant.", "t": "Я не это имел в виду.", "note": "", "cat": "opinion", "lvl": "B1"},
{"p": "I couldn't agree more.", "t": "Полностью согласен.", "note": "Буквально «не мог бы согласиться сильнее».", "cat": "opinion", "lvl": "B2"},

{"p": "Wow!", "t": "Ого! Вот это да!", "note": "", "cat": "reactions", "lvl": "A1"},
{"p": "Really?", "t": "Правда? Серьёзно?", "note": "", "cat": "reactions", "lvl": "A1"},
{"p": "That's great!", "t": "Здорово! Отлично!", "note": "", "cat": "reactions", "lvl": "A1"},
{"p": "That's awesome!", "t": "Круто!", "note": "Разговорно, особенно в США.", "cat": "reactions", "lvl": "A2"},
{"p": "No way!", "t": "Да ладно! Не может быть!", "note": "Удивление; может значить и «ни за что!».", "cat": "reactions", "lvl": "A2"},
{"p": "Are you kidding me?", "t": "Ты шутишь? Серьёзно?", "note": "Удивление или возмущение.", "cat": "reactions", "lvl": "A2"},
{"p": "I can't believe it!", "t": "Не могу поверить!", "note": "", "cat": "reactions", "lvl": "A2"},
{"p": "Oh my God!", "t": "Боже мой!", "note": "Пишут OMG; кто избегает упоминать Бога, говорит Oh my gosh.", "cat": "reactions", "lvl": "A2"},
{"p": "Oh no!", "t": "О нет! Ой!", "note": "", "cat": "reactions", "lvl": "A1"},
{"p": "What a shame.", "t": "Как жаль.", "note": "Не про стыд, а про сожаление.", "cat": "reactions", "lvl": "A2"},
{"p": "I'm sorry to hear that.", "t": "Мне очень жаль.", "note": "Сочувствие в ответ на плохую новость.", "cat": "reactions", "lvl": "A2"},
{"p": "Congratulations!", "t": "Поздравляю!", "note": "Разговорно сокращают до Congrats!", "cat": "reactions", "lvl": "A1"},
{"p": "Good for you!", "t": "Молодец! Рад за тебя!", "note": "", "cat": "reactions", "lvl": "A2"},
{"p": "I'm so excited!", "t": "Жду не дождусь! Я в восторге!", "note": "Excited — радостное предвкушение, а не «возбуждён».", "cat": "reactions", "lvl": "A2"},
{"p": "Thank goodness!", "t": "Слава богу!", "note": "Облегчение, когда всё обошлось.", "cat": "reactions", "lvl": "B1"},
{"p": "That's so annoying.", "t": "Как же это бесит.", "note": "", "cat": "reactions", "lvl": "B1"},

{"p": "Are you free tonight?", "t": "Ты свободен сегодня вечером?", "note": "", "cat": "plans", "lvl": "A2"},
{"p": "What are you doing this weekend?", "t": "Что делаешь на выходных?", "note": "", "cat": "plans", "lvl": "A2"},
{"p": "What time shall we meet?", "t": "Во сколько встретимся?", "note": "Shall — скорее британское; в США What time should we meet?", "cat": "plans", "lvl": "A2"},
{"p": "Let's meet at six.", "t": "Давай встретимся в шесть.", "note": "", "cat": "plans", "lvl": "A1"},
{"p": "How about Saturday?", "t": "Как насчёт субботы?", "note": "", "cat": "plans", "lvl": "A2"},
{"p": "Does Friday work for you?", "t": "Тебе удобно в пятницу?", "note": "Work for you — «подходит тебе».", "cat": "plans", "lvl": "B1"},
{"p": "I'm on my way.", "t": "Я уже еду. Уже иду.", "note": "В переписке часто OMW.", "cat": "plans", "lvl": "A2"},
{"p": "I'll be there in ten minutes.", "t": "Буду через десять минут.", "note": "", "cat": "plans", "lvl": "A2"},
{"p": "I'm running late.", "t": "Я опаздываю.", "note": "Говорят заранее, ещё в пути.", "cat": "plans", "lvl": "B1"},
{"p": "I can't make it today.", "t": "Я сегодня не смогу.", "note": "Make it — успеть, прийти, выбраться.", "cat": "plans", "lvl": "B1"},
{"p": "Something came up.", "t": "У меня кое-что случилось.", "note": "Вежливый повод отменить встречу без подробностей.", "cat": "plans", "lvl": "B1"},
{"p": "Let's do it another time.", "t": "Давай в другой раз.", "note": "", "cat": "plans", "lvl": "A2"},
{"p": "I'm busy all week.", "t": "Я всю неделю занят.", "note": "", "cat": "plans", "lvl": "A2"},
{"p": "Let's grab a coffee sometime.", "t": "Давай как-нибудь выпьем кофе.", "note": "Часто просто вежливость, без конкретного плана.", "cat": "plans", "lvl": "B1"},
{"p": "See you there!", "t": "Увидимся там!", "note": "", "cat": "plans", "lvl": "A2"},

{"p": "A table for two, please.", "t": "Столик на двоих, пожалуйста.", "note": "", "cat": "cafe", "lvl": "A1"},
{"p": "Can I see the menu, please?", "t": "Можно меню?", "note": "", "cat": "cafe", "lvl": "A1"},
{"p": "Are you ready to order?", "t": "Готовы сделать заказ?", "note": "Вопрос официанта.", "cat": "cafe", "lvl": "A2"},
{"p": "What do you recommend?", "t": "Что посоветуете?", "note": "", "cat": "cafe", "lvl": "A2"},
{"p": "I'll have the chicken salad.", "t": "Мне салат с курицей.", "note": "I'll have — стандартный способ заказать.", "cat": "cafe", "lvl": "A2"},
{"p": "Could I get a coffee, please?", "t": "Можно мне кофе?", "note": "В США чаще Can I get…; в Британии — Could I have…", "cat": "cafe", "lvl": "A2"},
{"p": "Still or sparkling?", "t": "С газом или без?", "note": "Вопрос официанта о воде.", "cat": "cafe", "lvl": "A2"},
{"p": "Could we have some water?", "t": "Можно нам воды?", "note": "", "cat": "cafe", "lvl": "A2"},
{"p": "I'm allergic to nuts.", "t": "У меня аллергия на орехи.", "note": "", "cat": "cafe", "lvl": "A2"},
{"p": "I'm vegetarian.", "t": "Я вегетарианец.", "note": "", "cat": "cafe", "lvl": "A2"},
{"p": "For here or to go?", "t": "Здесь или с собой?", "note": "Американский вариант; в Британии — Eat in or take away?", "cat": "cafe", "lvl": "A2"},
{"p": "It was delicious, thank you.", "t": "Было очень вкусно, спасибо.", "note": "", "cat": "cafe", "lvl": "A2"},
{"p": "Could I get the bill, please?", "t": "Счёт, пожалуйста.", "note": "Bill — британское; в США говорят the check.", "cat": "cafe", "lvl": "A2"},
{"p": "Can we pay separately?", "t": "Можно раздельный счёт?", "note": "", "cat": "cafe", "lvl": "B1"},
{"p": "Is service included?", "t": "Чаевые включены?", "note": "В США чаевые 15–20% почти обязательны.", "cat": "cafe", "lvl": "B1"},
{"p": "Keep the change.", "t": "Сдачи не надо.", "note": "", "cat": "cafe", "lvl": "A2"},

{"p": "How much is this?", "t": "Сколько это стоит?", "note": "", "cat": "shopping", "lvl": "A1"},
{"p": "I'm just looking, thanks.", "t": "Я просто смотрю, спасибо.", "note": "Ответ продавцу на Can I help you?", "cat": "shopping", "lvl": "A1"},
{"p": "I'm looking for a present.", "t": "Я ищу подарок.", "note": "", "cat": "shopping", "lvl": "A2"},
{"p": "Do you have this in a medium?", "t": "У вас есть такое размера M?", "note": "Размеры называют small, medium, large.", "cat": "shopping", "lvl": "A2"},
{"p": "Do you have it in black?", "t": "У вас есть такое в чёрном?", "note": "", "cat": "shopping", "lvl": "A2"},
{"p": "Can I try it on?", "t": "Можно примерить?", "note": "", "cat": "shopping", "lvl": "A2"},
{"p": "Where are the fitting rooms?", "t": "Где примерочные?", "note": "В США также dressing rooms.", "cat": "shopping", "lvl": "A2"},
{"p": "It's too big.", "t": "Мне велико.", "note": "", "cat": "shopping", "lvl": "A1"},
{"p": "That's a bit expensive.", "t": "Дороговато.", "note": "", "cat": "shopping", "lvl": "A2"},
{"p": "Is it on sale?", "t": "На это есть скидка?", "note": "On sale — по сниженной цене; for sale — просто продаётся.", "cat": "shopping", "lvl": "A2"},
{"p": "I'll take it.", "t": "Беру.", "note": "", "cat": "shopping", "lvl": "A2"},
{"p": "Can I pay by card?", "t": "Можно картой?", "note": "", "cat": "shopping", "lvl": "A1"},
{"p": "Do you take cash?", "t": "Наличные принимаете?", "note": "", "cat": "shopping", "lvl": "A2"},
{"p": "Do you need a bag?", "t": "Вам нужен пакет?", "note": "Вопрос кассира.", "cat": "shopping", "lvl": "A2"},
{"p": "Could I have a receipt?", "t": "Можно чек?", "note": "", "cat": "shopping", "lvl": "A2"},
{"p": "Can I return it?", "t": "Это можно вернуть?", "note": "", "cat": "shopping", "lvl": "A2"},

{"p": "How do I get to the station?", "t": "Как добраться до вокзала?", "note": "", "cat": "travel", "lvl": "A2"},
{"p": "Is it far from here?", "t": "Это далеко отсюда?", "note": "", "cat": "travel", "lvl": "A1"},
{"p": "I'm lost.", "t": "Я заблудился.", "note": "", "cat": "travel", "lvl": "A1"},
{"p": "A return ticket to London, please.", "t": "Билет до Лондона туда и обратно.", "note": "Return — британское; в США round-trip ticket.", "cat": "travel", "lvl": "A2"},
{"p": "Which platform is it?", "t": "С какой платформы?", "note": "", "cat": "travel", "lvl": "A2"},
{"p": "Does this bus go to the airport?", "t": "Этот автобус идёт до аэропорта?", "note": "", "cat": "travel", "lvl": "A2"},
{"p": "Where do I change?", "t": "Где мне пересаживаться?", "note": "Change — сделать пересадку.", "cat": "travel", "lvl": "B1"},
{"p": "Is this seat taken?", "t": "Здесь свободно?", "note": "Буквально «это место занято?» — ответ No значит «свободно».", "cat": "travel", "lvl": "A2"},
{"p": "My flight is delayed.", "t": "Мой рейс задерживается.", "note": "", "cat": "travel", "lvl": "A2"},
{"p": "I'm here on holiday.", "t": "Я здесь в отпуске.", "note": "Британское; в США — on vacation.", "cat": "travel", "lvl": "A2"},
{"p": "I have a reservation.", "t": "У меня бронь.", "note": "В отеле или ресторане.", "cat": "travel", "lvl": "A2"},
{"p": "Is breakfast included?", "t": "Завтрак включён?", "note": "", "cat": "travel", "lvl": "A2"},
{"p": "What time is check-out?", "t": "Во сколько выезд?", "note": "", "cat": "travel", "lvl": "A2"},
{"p": "Could you call me a taxi?", "t": "Вызовите мне такси, пожалуйста.", "note": "", "cat": "travel", "lvl": "A2"},
{"p": "Can you take me to this address?", "t": "Отвезите меня по этому адресу.", "note": "", "cat": "travel", "lvl": "A2"},

{"p": "Help!", "t": "Помогите!", "note": "", "cat": "help", "lvl": "A1"},
{"p": "Call an ambulance!", "t": "Вызовите скорую!", "note": "Экстренный номер: в Британии 999, в США 911.", "cat": "help", "lvl": "A1"},
{"p": "Can you call the police?", "t": "Вызовите полицию!", "note": "", "cat": "help", "lvl": "A2"},
{"p": "Are you all right?", "t": "Ты в порядке? Ты как?", "note": "Если человек упал или расстроен.", "cat": "help", "lvl": "A1"},
{"p": "What's wrong?", "t": "Что случилось?", "note": "", "cat": "help", "lvl": "A1"},
{"p": "I don't feel well.", "t": "Мне нехорошо.", "note": "", "cat": "help", "lvl": "A1"},
{"p": "I feel sick.", "t": "Меня тошнит.", "note": "В Британии чаще «тошнит»; в США может значить «я заболел».", "cat": "help", "lvl": "A2"},
{"p": "I've got a headache.", "t": "У меня болит голова.", "note": "", "cat": "help", "lvl": "A2"},
{"p": "It hurts here.", "t": "Вот здесь болит.", "note": "", "cat": "help", "lvl": "A2"},
{"p": "I think I've got a cold.", "t": "Кажется, я простыл.", "note": "", "cat": "help", "lvl": "A2"},
{"p": "I need a doctor.", "t": "Мне нужен врач.", "note": "", "cat": "help", "lvl": "A1"},
{"p": "Where's the nearest pharmacy?", "t": "Где ближайшая аптека?", "note": "В Британии говорят chemist's, в США — drugstore.", "cat": "help", "lvl": "A2"},
{"p": "I've lost my passport.", "t": "Я потерял паспорт.", "note": "", "cat": "help", "lvl": "A2"},
{"p": "My phone was stolen.", "t": "У меня украли телефон.", "note": "", "cat": "help", "lvl": "B1"},
{"p": "It doesn't work.", "t": "Не работает.", "note": "Про технику, кран, карту и т. п.", "cat": "help", "lvl": "A1"},
{"p": "Do you speak Russian?", "t": "Вы говорите по-русски?", "note": "", "cat": "help", "lvl": "A1"},

{"p": "Hello? Who's this?", "t": "Алло? Кто это?", "note": "Разговорно; вежливее — Who am I speaking to?", "cat": "phone", "lvl": "A2"},
{"p": "Can I speak to Tom, please?", "t": "Можно Тома к телефону?", "note": "", "cat": "phone", "lvl": "A2"},
{"p": "Hold on a second.", "t": "Секундочку, подожди.", "note": "", "cat": "phone", "lvl": "A2"},
{"p": "Can you hear me?", "t": "Ты меня слышишь?", "note": "", "cat": "phone", "lvl": "A1"},
{"p": "Sorry, you're breaking up.", "t": "Извини, тебя плохо слышно.", "note": "Когда связь прерывается.", "cat": "phone", "lvl": "B1"},
{"p": "I'll call you back.", "t": "Я перезвоню.", "note": "", "cat": "phone", "lvl": "A2"},
{"p": "Sorry, I missed your call.", "t": "Извини, пропустил твой звонок.", "note": "", "cat": "phone", "lvl": "A2"},
{"p": "Sorry, I was on another call.", "t": "Извини, я говорил по другой линии.", "note": "", "cat": "phone", "lvl": "B1"},
{"p": "Sorry, wrong number.", "t": "Извините, вы ошиблись номером.", "note": "", "cat": "phone", "lvl": "A2"},
{"p": "Can I leave a message?", "t": "Можно оставить сообщение?", "note": "", "cat": "phone", "lvl": "A2"},
{"p": "My battery's about to die.", "t": "У меня телефон садится.", "note": "", "cat": "phone", "lvl": "B1"},
{"p": "Text me when you get there.", "t": "Напиши, когда доберёшься.", "note": "Text — написать SMS или в мессенджер.", "cat": "phone", "lvl": "A2"},
{"p": "I'll send you the address.", "t": "Я скину тебе адрес.", "note": "", "cat": "phone", "lvl": "A2"},
{"p": "Let me give you my number.", "t": "Давай дам тебе свой номер.", "note": "", "cat": "phone", "lvl": "A2"},
{"p": "Just checking in.", "t": "Просто хотел узнать, как ты.", "note": "Начало сообщения или звонка без особого повода.", "cat": "phone", "lvl": "B1"},
{"p": "Drop me a line.", "t": "Черкни мне.", "note": "Разговорно: напиши сообщение или письмо.", "cat": "phone", "lvl": "B1"},

{"p": "I'm working from home today.", "t": "Сегодня работаю из дома.", "note": "", "cat": "work", "lvl": "A2"},
{"p": "Sorry, I've got a meeting.", "t": "Извини, у меня встреча.", "note": "", "cat": "work", "lvl": "A2"},
{"p": "Let's set up a meeting.", "t": "Давайте назначим встречу.", "note": "", "cat": "work", "lvl": "B1"},
{"p": "Could you send me the file?", "t": "Можешь прислать файл?", "note": "", "cat": "work", "lvl": "A2"},
{"p": "What's the deadline?", "t": "Какой срок? Когда дедлайн?", "note": "", "cat": "work", "lvl": "A2"},
{"p": "I'll get back to you.", "t": "Я вам отвечу позже.", "note": "Обещание вернуться с ответом, когда что-то выяснишь.", "cat": "work", "lvl": "B1"},
{"p": "Let me know if you have any questions.", "t": "Если будут вопросы, пишите.", "note": "Частая концовка рабочих писем.", "cat": "work", "lvl": "A2"},
{"p": "I'm on it.", "t": "Уже занимаюсь.", "note": "Быстрый ответ на поручение.", "cat": "work", "lvl": "B1"},
{"p": "I'm swamped right now.", "t": "Я сейчас завален работой.", "note": "Swamped — буквально «затоплен».", "cat": "work", "lvl": "B2"},
{"p": "I'm off tomorrow.", "t": "У меня завтра выходной.", "note": "", "cat": "work", "lvl": "B1"},
{"p": "Can we go over it again?", "t": "Можем ещё раз это пройти?", "note": "Go over — разобрать, просмотреть.", "cat": "work", "lvl": "B1"},
{"p": "Sorry, I didn't get that.", "t": "Извините, я не понял.", "note": "Get — здесь «понять».", "cat": "work", "lvl": "A2"},
{"p": "Good job!", "t": "Отличная работа! Молодец!", "note": "", "cat": "work", "lvl": "A1"},
{"p": "Let's call it a day.", "t": "На сегодня хватит.", "note": "Предложение закончить работу.", "cat": "work", "lvl": "B1"},
{"p": "I have an exam tomorrow.", "t": "У меня завтра экзамен.", "note": "", "cat": "work", "lvl": "A1"},
{"p": "What's the homework?", "t": "Что задали?", "note": "", "cat": "work", "lvl": "A1"},

{"p": "Never mind.", "t": "Неважно. Забудь.", "note": "Когда передумал объяснять или просить.", "cat": "everyday", "lvl": "A2"},
{"p": "It's up to you.", "t": "Решай сам. Как скажешь.", "note": "", "cat": "everyday", "lvl": "A2"},
{"p": "No worries.", "t": "Ничего страшного. Не парься.", "note": "Ответ на спасибо и на извинения; особенно в Британии и Австралии.", "cat": "everyday", "lvl": "A2"},
{"p": "Sounds good.", "t": "Отлично, договорились.", "note": "Согласие с предложением или планом.", "cat": "everyday", "lvl": "A2"},
{"p": "Got it.", "t": "Понял. Ясно.", "note": "", "cat": "everyday", "lvl": "A2"},
{"p": "Sure.", "t": "Конечно. Ага.", "note": "", "cat": "everyday", "lvl": "A1"},
{"p": "I don't mind.", "t": "Мне всё равно. Я не против.", "note": "Вежливо и без негатива, в отличие от Whatever.", "cat": "everyday", "lvl": "A2"},
{"p": "Whatever.", "t": "Да без разницы. Как хочешь.", "note": "Часто звучит грубо и пренебрежительно.", "cat": "everyday", "lvl": "B1"},
{"p": "Same here.", "t": "У меня тоже. Я тоже.", "note": "", "cat": "everyday", "lvl": "A2"},
{"p": "Go ahead.", "t": "Давай. Пожалуйста.", "note": "Разрешение: говори, бери, делай.", "cat": "everyday", "lvl": "A2"},
{"p": "Here you go.", "t": "Вот, держи.", "note": "Когда что-то протягиваешь.", "cat": "everyday", "lvl": "A2"},
{"p": "Take your time.", "t": "Не торопись.", "note": "", "cat": "everyday", "lvl": "A2"},
{"p": "Let me think.", "t": "Дай подумать.", "note": "", "cat": "everyday", "lvl": "A2"},
{"p": "No big deal.", "t": "Пустяки. Ничего особенного.", "note": "", "cat": "everyday", "lvl": "B1"},
{"p": "My bad.", "t": "Моя вина. Сорян.", "note": "Очень разговорно, о мелкой ошибке.", "cat": "everyday", "lvl": "B1"},
{"p": "Anyway.", "t": "Короче. В общем.", "note": "Чтобы сменить тему или вернуться к главному.", "cat": "everyday", "lvl": "B1"},
{"p": "Tell me about it!", "t": "И не говори!", "note": "Не просьба рассказать, а согласие с жалобой.", "cat": "everyday", "lvl": "B2"},

{"p": "It's a piece of cake.", "t": "Проще простого.", "note": "Буквально «кусок торта».", "cat": "idioms", "lvl": "B1"},
{"p": "Better late than never.", "t": "Лучше поздно, чем никогда.", "note": "", "cat": "idioms", "lvl": "A2"},
{"p": "Time flies!", "t": "Время летит!", "note": "", "cat": "idioms", "lvl": "A2"},
{"p": "Speak of the devil!", "t": "Лёгок на помине!", "note": "Когда появляется тот, о ком говорили.", "cat": "idioms", "lvl": "B1"},
{"p": "Break a leg!", "t": "Ни пуха ни пера!", "note": "Пожелание удачи перед выступлением; буквально «сломай ногу».", "cat": "idioms", "lvl": "B1"},
{"p": "I'll keep my fingers crossed.", "t": "Буду держать за тебя кулачки.", "note": "Буквально «скрещу пальцы».", "cat": "idioms", "lvl": "B1"},
{"p": "It's not my cup of tea.", "t": "Это не моё.", "note": "Буквально «не моя чашка чая».", "cat": "idioms", "lvl": "B1"},
{"p": "Easier said than done.", "t": "Легко сказать.", "note": "", "cat": "idioms", "lvl": "B1"},
{"p": "I'm all ears.", "t": "Я весь внимание.", "note": "Буквально «я весь уши».", "cat": "idioms", "lvl": "B1"},
{"p": "That rings a bell.", "t": "Что-то знакомое.", "note": "Когда смутно что-то припоминаешь.", "cat": "idioms", "lvl": "B1"},
{"p": "Actions speak louder than words.", "t": "Судят не по словам, а по делам.", "note": "", "cat": "idioms", "lvl": "B1"},
{"p": "It costs an arm and a leg.", "t": "Стоит целое состояние.", "note": "Буквально «стоит руку и ногу».", "cat": "idioms", "lvl": "B2"},
{"p": "I'm feeling a bit under the weather.", "t": "Мне что-то нездоровится.", "note": "Мягко о лёгком недомогании.", "cat": "idioms", "lvl": "B2"},
{"p": "You hit the nail on the head.", "t": "Ты попал в точку.", "note": "Буквально «попал гвоздю по шляпке».", "cat": "idioms", "lvl": "B2"},
{"p": "Let's play it by ear.", "t": "Сориентируемся по ходу.", "note": "Решим на месте, без чёткого плана.", "cat": "idioms", "lvl": "B2"},
{"p": "Stop beating around the bush.", "t": "Хватит ходить вокруг да около.", "note": "В Британии чаще beating about the bush.", "cat": "idioms", "lvl": "B2"},
{"p": "Once in a blue moon.", "t": "Раз в сто лет.", "note": "Буквально «раз в голубую луну».", "cat": "idioms", "lvl": "B2"}
]
