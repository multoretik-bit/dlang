[
{"p": "¡Hola! ¿Qué tal?", "t": "Привет! Как дела?", "note": "Самое частое приветствие, подходит почти для любой ситуации.", "cat": "greetings", "lvl": "A1"},
{"p": "Buenos días.", "t": "Доброе утро. / Добрый день.", "note": "До обеда; в Испании обед поздний, так что примерно до 14:00.", "cat": "greetings", "lvl": "A1"},
{"p": "Buenas tardes.", "t": "Добрый день. / Добрый вечер.", "note": "После обеда и до темноты.", "cat": "greetings", "lvl": "A1"},
{"p": "Buenas noches.", "t": "Добрый вечер. / Спокойной ночи.", "note": "И при встрече поздно вечером, и перед сном.", "cat": "greetings", "lvl": "A1"},
{"p": "¡Buenas!", "t": "Здрасьте! / Привет!", "note": "Разговорное сокращение, годится в любое время суток.", "cat": "greetings", "lvl": "A1"},
{"p": "Hasta luego.", "t": "Пока. / До свидания.", "note": "Самое частое прощание — даже если больше не увидитесь.", "cat": "greetings", "lvl": "A1"},
{"p": "¡Hasta mañana!", "t": "До завтра!", "note": "", "cat": "greetings", "lvl": "A1"},
{"p": "¡Hasta pronto!", "t": "До скорого!", "note": "", "cat": "greetings", "lvl": "A1"},
{"p": "Nos vemos.", "t": "Увидимся.", "note": "Непринуждённое прощание с друзьями и коллегами.", "cat": "greetings", "lvl": "A1"},
{"p": "¡Chao!", "t": "Пока!", "note": "Разговорно, между знакомыми; в Аргентине пишут chau.", "cat": "greetings", "lvl": "A1"},
{"p": "¡Bienvenidos!", "t": "Добро пожаловать!", "note": "Одному мужчине — bienvenido, женщине — bienvenida.", "cat": "greetings", "lvl": "A1"},
{"p": "¡Cuánto tiempo!", "t": "Сколько лет, сколько зим!", "note": "Когда долго не виделись.", "cat": "greetings", "lvl": "A2"},
{"p": "Me alegro de verte.", "t": "Рад тебя видеть.", "note": "", "cat": "greetings", "lvl": "A2"},
{"p": "Que tengas un buen día.", "t": "Хорошего дня!", "note": "На «вы»: Que tenga un buen día.", "cat": "greetings", "lvl": "A2"},
{"p": "¡Cuídate!", "t": "Береги себя!", "note": "Тёплое прощание с близкими.", "cat": "greetings", "lvl": "A2"},
{"p": "Bueno, me voy.", "t": "Ладно, я пошёл.", "note": "Женщина скажет так же; удобно, чтобы закончить разговор.", "cat": "greetings", "lvl": "A2"},

{"p": "¿Cómo estás?", "t": "Как ты?", "note": "На «вы»: ¿Cómo está usted?", "cat": "smalltalk", "lvl": "A1"},
{"p": "Bien, ¿y tú?", "t": "Хорошо, а ты?", "note": "", "cat": "smalltalk", "lvl": "A1"},
{"p": "Muy bien, gracias.", "t": "Очень хорошо, спасибо.", "note": "", "cat": "smalltalk", "lvl": "A1"},
{"p": "¿Cómo va todo?", "t": "Как вообще дела?", "note": "", "cat": "smalltalk", "lvl": "A1"},
{"p": "Tirando.", "t": "Потихоньку. / Помаленьку.", "note": "Разговорно: «так себе, но жить можно».", "cat": "smalltalk", "lvl": "A2"},
{"p": "No me puedo quejar.", "t": "Грех жаловаться.", "note": "", "cat": "smalltalk", "lvl": "A2"},
{"p": "¿Qué hay de nuevo?", "t": "Что нового?", "note": "", "cat": "smalltalk", "lvl": "A2"},
{"p": "Nada, lo de siempre.", "t": "Да ничего, всё как обычно.", "note": "", "cat": "smalltalk", "lvl": "A2"},
{"p": "¿Qué tal el fin de semana?", "t": "Как прошли выходные?", "note": "Типичный вопрос коллегам в понедельник.", "cat": "smalltalk", "lvl": "A2"},
{"p": "¿Qué tal el trabajo?", "t": "Как работа?", "note": "", "cat": "smalltalk", "lvl": "A2"},
{"p": "¿Y la familia, bien?", "t": "А семья как, все здоровы?", "note": "", "cat": "smalltalk", "lvl": "A2"},
{"p": "¿Qué haces por aquí?", "t": "Какими судьбами?", "note": "При неожиданной встрече со знакомым.", "cat": "smalltalk", "lvl": "A2"},
{"p": "¡Qué calor hace hoy!", "t": "Ну и жара сегодня!", "note": "", "cat": "smalltalk", "lvl": "A2"},
{"p": "Parece que va a llover.", "t": "Похоже, будет дождь.", "note": "", "cat": "smalltalk", "lvl": "A2"},
{"p": "Hace un frío que pela.", "t": "Холод собачий.", "note": "Разговорно; букв. «холод, который сдирает кожу».", "cat": "smalltalk", "lvl": "B1"},
{"p": "¿Qué es de tu vida?", "t": "Как ты там, что у тебя нового?", "note": "Когда давно не общались.", "cat": "smalltalk", "lvl": "B1"},
{"p": "¿Qué pasa, tío?", "t": "Здорово, чувак!", "note": "Сленг, Испания; только между друзьями. Подруге — tía.", "cat": "smalltalk", "lvl": "B1"},

{"p": "¿Cómo te llamas?", "t": "Как тебя зовут?", "note": "На «вы»: ¿Cómo se llama usted?", "cat": "intro", "lvl": "A1"},
{"p": "Me llamo Anna.", "t": "Меня зовут Анна.", "note": "", "cat": "intro", "lvl": "A1"},
{"p": "Encantado.", "t": "Очень приятно.", "note": "Женщина говорит encantada.", "cat": "intro", "lvl": "A1"},
{"p": "Mucho gusto.", "t": "Очень приятно.", "note": "Чуть формальнее, не зависит от пола; в Латинской Америке — основной вариант.", "cat": "intro", "lvl": "A1"},
{"p": "Igualmente.", "t": "Взаимно.", "note": "Ответ на «Encantado» или на пожелание.", "cat": "intro", "lvl": "A1"},
{"p": "¿De dónde eres?", "t": "Откуда ты?", "note": "На «вы»: ¿De dónde es usted?", "cat": "intro", "lvl": "A1"},
{"p": "Soy de Rusia, de Moscú.", "t": "Я из России, из Москвы.", "note": "", "cat": "intro", "lvl": "A1"},
{"p": "¿Cuántos años tienes?", "t": "Сколько тебе лет?", "note": "", "cat": "intro", "lvl": "A1"},
{"p": "Tengo veinticinco años.", "t": "Мне двадцать пять лет.", "note": "Букв. «я имею 25 лет» — возраст выражают глаголом tener.", "cat": "intro", "lvl": "A1"},
{"p": "¿Dónde vives?", "t": "Где ты живёшь?", "note": "", "cat": "intro", "lvl": "A1"},
{"p": "Estoy aprendiendo español.", "t": "Я учу испанский.", "note": "", "cat": "intro", "lvl": "A1"},
{"p": "¿A qué te dedicas?", "t": "Чем ты занимаешься?", "note": "Вежливый вопрос о профессии.", "cat": "intro", "lvl": "A2"},
{"p": "Trabajo de programador.", "t": "Я работаю программистом.", "note": "", "cat": "intro", "lvl": "A2"},
{"p": "Te presento a mi amigo Pablo.", "t": "Познакомься, это мой друг Пабло.", "note": "", "cat": "intro", "lvl": "A2"},
{"p": "¿Nos conocemos?", "t": "Мы раньше не встречались?", "note": "", "cat": "intro", "lvl": "A2"},
{"p": "Llevo un año viviendo aquí.", "t": "Я живу здесь уже год.", "note": "Llevar + время + герундий = «уже столько-то делаю».", "cat": "intro", "lvl": "B1"},

{"p": "Muchas gracias.", "t": "Большое спасибо.", "note": "", "cat": "polite", "lvl": "A1"},
{"p": "De nada.", "t": "Не за что.", "note": "", "cat": "polite", "lvl": "A1"},
{"p": "Por favor.", "t": "Пожалуйста.", "note": "Только в просьбе. «Вот, держите» — Aquí tiene.", "cat": "polite", "lvl": "A1"},
{"p": "Perdón.", "t": "Простите. / Извините.", "note": "Извиниться или переспросить.", "cat": "polite", "lvl": "A1"},
{"p": "Disculpe.", "t": "Извините, можно вас?", "note": "Привлечь внимание незнакомца, на «вы». На «ты» — disculpa / perdona.", "cat": "polite", "lvl": "A1"},
{"p": "Lo siento mucho.", "t": "Мне очень жаль.", "note": "Серьёзное извинение или сочувствие.", "cat": "polite", "lvl": "A1"},
{"p": "No pasa nada.", "t": "Ничего страшного.", "note": "Самый частый ответ на извинение.", "cat": "polite", "lvl": "A1"},
{"p": "¡Salud!", "t": "Будь здоров! / За здоровье!", "note": "И когда кто-то чихнул, и как тост.", "cat": "polite", "lvl": "A1"},
{"p": "Gracias por todo.", "t": "Спасибо за всё.", "note": "", "cat": "polite", "lvl": "A2"},
{"p": "A ti.", "t": "Тебе спасибо.", "note": "Ответ на «gracias»: «это тебе спасибо». На «вы» — A usted.", "cat": "polite", "lvl": "A2"},
{"p": "Con permiso.", "t": "Разрешите пройти.", "note": "Пройти мимо кого-то или войти.", "cat": "polite", "lvl": "A2"},
{"p": "Es usted muy amable.", "t": "Вы очень любезны.", "note": "Формально.", "cat": "polite", "lvl": "A2"},
{"p": "Siento llegar tarde.", "t": "Извините за опоздание.", "note": "", "cat": "polite", "lvl": "A2"},
{"p": "Pasa, pasa.", "t": "Проходи, проходи.", "note": "Приглашение войти; на «вы» — pase.", "cat": "polite", "lvl": "A2"},
{"p": "Te lo agradezco mucho.", "t": "Я тебе очень благодарен.", "note": "", "cat": "polite", "lvl": "B1"},
{"p": "Disculpa las molestias.", "t": "Извини за беспокойство.", "note": "", "cat": "polite", "lvl": "B1"},

{"p": "¿Puedes ayudarme?", "t": "Можешь мне помочь?", "note": "На «вы»: ¿Puede ayudarme?", "cat": "requests", "lvl": "A1"},
{"p": "No entiendo.", "t": "Я не понимаю.", "note": "", "cat": "requests", "lvl": "A1"},
{"p": "¿Me lo puedes repetir, por favor?", "t": "Можешь повторить, пожалуйста?", "note": "", "cat": "requests", "lvl": "A1"},
{"p": "Más despacio, por favor.", "t": "Помедленнее, пожалуйста.", "note": "", "cat": "requests", "lvl": "A1"},
{"p": "¿Cómo se dice «ventana» en español?", "t": "Как по-испански «окно»?", "note": "", "cat": "requests", "lvl": "A1"},
{"p": "¿Qué significa esto?", "t": "Что это значит?", "note": "", "cat": "requests", "lvl": "A1"},
{"p": "¿Dónde está el baño?", "t": "Где туалет?", "note": "В Испании также говорят ¿Dónde están los servicios?", "cat": "requests", "lvl": "A1"},
{"p": "¿Puedo pasar?", "t": "Можно войти?", "note": "", "cat": "requests", "lvl": "A1"},
{"p": "¿Tienes un momento?", "t": "Есть минутка?", "note": "", "cat": "requests", "lvl": "A2"},
{"p": "¿Me haces un favor?", "t": "Можно тебя попросить?", "note": "Букв. «сделаешь мне одолжение?»", "cat": "requests", "lvl": "A2"},
{"p": "¿Me dejas tu boli?", "t": "Одолжишь ручку?", "note": "Boli — разговорное от bolígrafo. Dejar здесь — «дать на время».", "cat": "requests", "lvl": "A2"},
{"p": "¿Me lo puedes explicar?", "t": "Можешь мне объяснить?", "note": "", "cat": "requests", "lvl": "A2"},
{"p": "¿Sabes dónde hay un cajero?", "t": "Не знаешь, где тут банкомат?", "note": "", "cat": "requests", "lvl": "A2"},
{"p": "¿Podría decirme qué hora es?", "t": "Не подскажете, который час?", "note": "Вежливо, на «вы».", "cat": "requests", "lvl": "A2"},
{"p": "¿Te importa si abro la ventana?", "t": "Ты не против, если я открою окно?", "note": "", "cat": "requests", "lvl": "B1"},
{"p": "¿Me echas una mano?", "t": "Поможешь?", "note": "Разговорно; букв. «бросишь мне руку».", "cat": "requests", "lvl": "B1"},

{"p": "Estoy de acuerdo.", "t": "Согласен.", "note": "", "cat": "opinion", "lvl": "A1"},
{"p": "No estoy de acuerdo.", "t": "Я не согласен.", "note": "", "cat": "opinion", "lvl": "A1"},
{"p": "Tienes razón.", "t": "Ты прав.", "note": "", "cat": "opinion", "lvl": "A1"},
{"p": "Creo que sí.", "t": "Думаю, да.", "note": "Отрицание — Creo que no.", "cat": "opinion", "lvl": "A1"},
{"p": "¡Claro que sí!", "t": "Конечно!", "note": "", "cat": "opinion", "lvl": "A1"},
{"p": "¡Exacto!", "t": "Именно! / Точно!", "note": "", "cat": "opinion", "lvl": "A1"},
{"p": "Me da igual.", "t": "Мне всё равно.", "note": "", "cat": "opinion", "lvl": "A1"},
{"p": "Puede ser.", "t": "Может быть.", "note": "", "cat": "opinion", "lvl": "A1"},
{"p": "A mí también.", "t": "Мне тоже.", "note": "Ответ на фразы с gustar: Me gusta. — A mí también.", "cat": "opinion", "lvl": "A1"},
{"p": "A mí tampoco.", "t": "Мне тоже нет.", "note": "Ответ на отрицание: No me gusta. — A mí tampoco.", "cat": "opinion", "lvl": "A2"},
{"p": "Depende.", "t": "Смотря как. / Зависит от ситуации.", "note": "", "cat": "opinion", "lvl": "A2"},
{"p": "Para mí, es mejor así.", "t": "По-моему, так лучше.", "note": "", "cat": "opinion", "lvl": "A2"},
{"p": "No sé qué decirte.", "t": "Даже не знаю, что сказать.", "note": "", "cat": "opinion", "lvl": "A2"},
{"p": "En mi opinión, no merece la pena.", "t": "По-моему, оно того не стоит.", "note": "", "cat": "opinion", "lvl": "B1"},
{"p": "¡Qué va!", "t": "Да ну, что ты! / Вовсе нет.", "note": "Испания, разговорно: решительное «нет».", "cat": "opinion", "lvl": "B1"},
{"p": "¡Ni de broma!", "t": "Ни за что!", "note": "Букв. «даже в шутку нет».", "cat": "opinion", "lvl": "B1"},
{"p": "Lo veo difícil.", "t": "Сомневаюсь, что получится.", "note": "Мягкий способ выразить сомнение.", "cat": "opinion", "lvl": "B1"},

{"p": "¡Qué bien!", "t": "Как здорово!", "note": "", "cat": "reactions", "lvl": "A1"},
{"p": "¡Qué pena!", "t": "Как жаль!", "note": "", "cat": "reactions", "lvl": "A1"},
{"p": "¡Felicidades!", "t": "Поздравляю! / С днём рождения!", "note": "С праздником или днём рождения; с успехом — ¡Enhorabuena!", "cat": "reactions", "lvl": "A1"},
{"p": "¡Enhorabuena!", "t": "Поздравляю!", "note": "С достижением: экзамен, работа, рождение ребёнка.", "cat": "reactions", "lvl": "A2"},
{"p": "¡No me digas!", "t": "Да ты что! / Не может быть!", "note": "", "cat": "reactions", "lvl": "A2"},
{"p": "¡Madre mía!", "t": "Мама дорогая! / Боже мой!", "note": "", "cat": "reactions", "lvl": "A2"},
{"p": "¡Menos mal!", "t": "Слава богу! / Ну хоть так!", "note": "Облегчение после тревоги.", "cat": "reactions", "lvl": "A2"},
{"p": "¡Qué asco!", "t": "Фу, гадость!", "note": "", "cat": "reactions", "lvl": "A2"},
{"p": "¡Qué susto!", "t": "Ну ты меня напугал!", "note": "Букв. «какой испуг!»", "cat": "reactions", "lvl": "A2"},
{"p": "¡Qué vergüenza!", "t": "Как стыдно!", "note": "", "cat": "reactions", "lvl": "A2"},
{"p": "¡Qué raro!", "t": "Как странно!", "note": "", "cat": "reactions", "lvl": "A2"},
{"p": "¡Ojalá!", "t": "Хорошо бы! / Дай бог!", "note": "", "cat": "reactions", "lvl": "A2"},
{"p": "¡Qué guay!", "t": "Круто! / Классно!", "note": "Испания; в Мексике — ¡Qué padre!, в Аргентине — ¡Qué bueno!", "cat": "reactions", "lvl": "A2"},
{"p": "¡Qué rollo!", "t": "Какая тоска! / Вот засада!", "note": "Испания, разговорно: о скучном или неприятном.", "cat": "reactions", "lvl": "B1"},
{"p": "¡Qué fuerte!", "t": "Офигеть! / Ничего себе!", "note": "Испания, разговорно: о шокирующей новости.", "cat": "reactions", "lvl": "B1"},
{"p": "¡Estoy harto!", "t": "Мне надоело! / Достало!", "note": "Женщина: Estoy harta.", "cat": "reactions", "lvl": "B1"},
{"p": "¡Anda ya!", "t": "Да ладно! / Не гони!", "note": "Испания, разговорно: недоверие.", "cat": "reactions", "lvl": "B1"},
{"p": "¡Qué ilusión!", "t": "Как я рада! / Вот это радость!", "note": "Испания: радость и предвкушение чего-то приятного.", "cat": "reactions", "lvl": "B1"},

{"p": "¿Qué hora es?", "t": "Который час?", "note": "", "cat": "plans", "lvl": "A1"},
{"p": "Son las tres y media.", "t": "Половина четвёртого.", "note": "Час дня — Es la una.", "cat": "plans", "lvl": "A1"},
{"p": "¿Qué haces esta noche?", "t": "Что делаешь сегодня вечером?", "note": "", "cat": "plans", "lvl": "A1"},
{"p": "Ahora no puedo.", "t": "Сейчас не могу.", "note": "", "cat": "plans", "lvl": "A1"},
{"p": "Mañana por la mañana.", "t": "Завтра утром.", "note": "Mañana — и «завтра», и «утро».", "cat": "plans", "lvl": "A1"},
{"p": "¿Quedamos mañana?", "t": "Встретимся завтра?", "note": "Quedar — «договориться о встрече», очень частый глагол.", "cat": "plans", "lvl": "A2"},
{"p": "¿A qué hora quedamos?", "t": "Во сколько встречаемся?", "note": "", "cat": "plans", "lvl": "A2"},
{"p": "Nos vemos a las ocho en la plaza.", "t": "Встречаемся в восемь на площади.", "note": "", "cat": "plans", "lvl": "A2"},
{"p": "Vamos a tomar algo.", "t": "Пойдём посидим где-нибудь.", "note": "Tomar algo — зайти в бар или кафе, не обязательно выпить.", "cat": "plans", "lvl": "A2"},
{"p": "¿Tienes planes para el finde?", "t": "Есть планы на выходные?", "note": "Finde — разговорное от fin de semana.", "cat": "plans", "lvl": "A2"},
{"p": "Llego en cinco minutos.", "t": "Буду через пять минут.", "note": "", "cat": "plans", "lvl": "A2"},
{"p": "Voy tarde.", "t": "Я опаздываю.", "note": "", "cat": "plans", "lvl": "A2"},
{"p": "Te espero en la puerta.", "t": "Жду тебя у входа.", "note": "", "cat": "plans", "lvl": "A2"},
{"p": "Hoy no, mejor otro día.", "t": "Сегодня нет, давай в другой раз.", "note": "", "cat": "plans", "lvl": "A2"},
{"p": "¿Te viene bien el viernes?", "t": "Тебе удобно в пятницу?", "note": "", "cat": "plans", "lvl": "B1"},
{"p": "Lo dejamos para la semana que viene.", "t": "Давай перенесём на следующую неделю.", "note": "", "cat": "plans", "lvl": "B1"},
{"p": "Al final no puedo ir.", "t": "В итоге я не смогу пойти.", "note": "", "cat": "plans", "lvl": "B1"},
{"p": "¿Te apuntas?", "t": "Ты с нами?", "note": "Приглашение присоединиться к общему плану.", "cat": "plans", "lvl": "B1"},

{"p": "Una mesa para dos, por favor.", "t": "Столик на двоих, пожалуйста.", "note": "", "cat": "cafe", "lvl": "A1"},
{"p": "Un café con leche, por favor.", "t": "Кофе с молоком, пожалуйста.", "note": "", "cat": "cafe", "lvl": "A1"},
{"p": "Para mí, la paella.", "t": "Мне паэлью.", "note": "Так заказывают, когда официант спрашивает каждого.", "cat": "cafe", "lvl": "A1"},
{"p": "La cuenta, por favor.", "t": "Счёт, пожалуйста.", "note": "", "cat": "cafe", "lvl": "A1"},
{"p": "Está buenísimo.", "t": "Очень вкусно!", "note": "", "cat": "cafe", "lvl": "A1"},
{"p": "Para llevar.", "t": "С собой.", "note": "«Здесь» — para tomar aquí.", "cat": "cafe", "lvl": "A1"},
{"p": "Sin hielo, por favor.", "t": "Без льда, пожалуйста.", "note": "", "cat": "cafe", "lvl": "A1"},
{"p": "¿Me pones un café?", "t": "Можно мне кофе?", "note": "Испания, в баре; в Латинской Америке — ¿Me da un café?", "cat": "cafe", "lvl": "A2"},
{"p": "¿Nos trae la carta, por favor?", "t": "Принесите, пожалуйста, меню.", "note": "В Латинской Америке чаще el menú.", "cat": "cafe", "lvl": "A2"},
{"p": "¿Qué nos recomienda?", "t": "Что вы нам посоветуете?", "note": "", "cat": "cafe", "lvl": "A2"},
{"p": "¿Qué lleva este plato?", "t": "Что входит в это блюдо?", "note": "", "cat": "cafe", "lvl": "A2"},
{"p": "Una caña, por favor.", "t": "Пиво, пожалуйста.", "note": "Испания: разливное пиво в небольшом бокале.", "cat": "cafe", "lvl": "A2"},
{"p": "¡Que aproveche!", "t": "Приятного аппетита!", "note": "Говорят даже незнакомым, проходя мимо их стола.", "cat": "cafe", "lvl": "A2"},
{"p": "¿Me trae un poco más de agua?", "t": "Можно ещё немного воды?", "note": "", "cat": "cafe", "lvl": "A2"},
{"p": "Invito yo.", "t": "Я угощаю.", "note": "", "cat": "cafe", "lvl": "A2"},
{"p": "¿Pagamos a medias?", "t": "Платим пополам?", "note": "", "cat": "cafe", "lvl": "B1"},
{"p": "Soy alérgico a los frutos secos.", "t": "У меня аллергия на орехи.", "note": "Женщина: alérgica.", "cat": "cafe", "lvl": "B1"},

{"p": "¿Cuánto cuesta esto?", "t": "Сколько это стоит?", "note": "", "cat": "shopping", "lvl": "A1"},
{"p": "Solo estoy mirando, gracias.", "t": "Я просто смотрю, спасибо.", "note": "Ответ продавцу на «¿Le puedo ayudar?»", "cat": "shopping", "lvl": "A1"},
{"p": "¿Puedo pagar con tarjeta?", "t": "Можно оплатить картой?", "note": "", "cat": "shopping", "lvl": "A1"},
{"p": "¿Efectivo o tarjeta?", "t": "Наличными или картой?", "note": "Так спрашивает кассир.", "cat": "shopping", "lvl": "A1"},
{"p": "¿Dónde está la caja?", "t": "Где касса?", "note": "", "cat": "shopping", "lvl": "A1"},
{"p": "¿A qué hora cierran?", "t": "Во сколько вы закрываетесь?", "note": "", "cat": "shopping", "lvl": "A1"},
{"p": "¿Tiene esta camiseta en la talla M?", "t": "У вас есть эта футболка размера M?", "note": "", "cat": "shopping", "lvl": "A2"},
{"p": "¿Puedo probármelo?", "t": "Можно примерить?", "note": "", "cat": "shopping", "lvl": "A2"},
{"p": "¿Dónde están los probadores?", "t": "Где примерочные?", "note": "", "cat": "shopping", "lvl": "A2"},
{"p": "Me queda grande.", "t": "Мне велико.", "note": "Мало — Me queda pequeño.", "cat": "shopping", "lvl": "A2"},
{"p": "¿Tienen otro color?", "t": "У вас есть другой цвет?", "note": "", "cat": "shopping", "lvl": "A2"},
{"p": "Me lo llevo.", "t": "Беру.", "note": "Букв. «я это уношу».", "cat": "shopping", "lvl": "A2"},
{"p": "¿Está en oferta?", "t": "Это по акции?", "note": "Сезонные распродажи в Испании — las rebajas.", "cat": "shopping", "lvl": "A2"},
{"p": "¿Me da una bolsa?", "t": "Можно пакет?", "note": "В Испании пакеты обычно платные.", "cat": "shopping", "lvl": "A2"},
{"p": "Es demasiado caro.", "t": "Это слишком дорого.", "note": "", "cat": "shopping", "lvl": "A2"},
{"p": "Quería devolver esto.", "t": "Я бы хотел это вернуть.", "note": "Quería — вежливая форма «хотел бы».", "cat": "shopping", "lvl": "B1"},
{"p": "¿Me lo envuelve para regalo?", "t": "Можете упаковать в подарок?", "note": "", "cat": "shopping", "lvl": "B1"},

{"p": "¿Está lejos de aquí?", "t": "Это далеко отсюда?", "note": "", "cat": "travel", "lvl": "A1"},
{"p": "Un billete para Madrid, por favor.", "t": "Один билет до Мадрида, пожалуйста.", "note": "В Латинской Америке — boleto.", "cat": "travel", "lvl": "A1"},
{"p": "¿A qué hora sale el tren?", "t": "Во сколько отправляется поезд?", "note": "", "cat": "travel", "lvl": "A1"},
{"p": "¿Este autobús va al aeropuerto?", "t": "Этот автобус идёт в аэропорт?", "note": "", "cat": "travel", "lvl": "A1"},
{"p": "¿Dónde está la parada de metro?", "t": "Где станция метро?", "note": "", "cat": "travel", "lvl": "A1"},
{"p": "¿A qué hora es el desayuno?", "t": "Во сколько завтрак?", "note": "", "cat": "travel", "lvl": "A1"},
{"p": "¿Hay wifi en la habitación?", "t": "В номере есть вайфай?", "note": "В Испании произносят «уи-фи».", "cat": "travel", "lvl": "A1"},
{"p": "¿Cómo llego al centro?", "t": "Как добраться до центра?", "note": "", "cat": "travel", "lvl": "A2"},
{"p": "Todo recto y luego a la derecha.", "t": "Прямо, а потом направо.", "note": "Налево — a la izquierda.", "cat": "travel", "lvl": "A2"},
{"p": "¿De ida y vuelta?", "t": "Туда и обратно?", "note": "В одну сторону — solo ida.", "cat": "travel", "lvl": "A2"},
{"p": "Tengo una reserva a nombre de Iván Petrov.", "t": "У меня бронь на имя Ивана Петрова.", "note": "", "cat": "travel", "lvl": "A2"},
{"p": "¿Dónde puedo dejar la maleta?", "t": "Где можно оставить чемодан?", "note": "", "cat": "travel", "lvl": "A2"},
{"p": "¿Me puede pedir un taxi?", "t": "Можете вызвать мне такси?", "note": "", "cat": "travel", "lvl": "A2"},
{"p": "Me he perdido.", "t": "Я заблудился.", "note": "", "cat": "travel", "lvl": "A2"},
{"p": "¿Me puede hacer una foto?", "t": "Можете меня сфотографировать?", "note": "В Латинской Америке чаще tomar una foto.", "cat": "travel", "lvl": "A2"},
{"p": "¿Me deja aquí, por favor?", "t": "Остановите здесь, пожалуйста.", "note": "Таксисту.", "cat": "travel", "lvl": "B1"},
{"p": "Han cancelado el vuelo.", "t": "Рейс отменили.", "note": "", "cat": "travel", "lvl": "B1"},

{"p": "¡Socorro!", "t": "Помогите!", "note": "Крик о помощи в опасности.", "cat": "help", "lvl": "A1"},
{"p": "¡Cuidado!", "t": "Осторожно!", "note": "", "cat": "help", "lvl": "A1"},
{"p": "Necesito un médico.", "t": "Мне нужен врач.", "note": "", "cat": "help", "lvl": "A1"},
{"p": "Me duele la cabeza.", "t": "У меня болит голова.", "note": "", "cat": "help", "lvl": "A1"},
{"p": "Tengo fiebre.", "t": "У меня температура.", "note": "", "cat": "help", "lvl": "A1"},
{"p": "¿Estás bien?", "t": "Ты в порядке?", "note": "", "cat": "help", "lvl": "A1"},
{"p": "¿Qué te pasa?", "t": "Что с тобой?", "note": "", "cat": "help", "lvl": "A1"},
{"p": "¡Llamen a una ambulancia!", "t": "Вызовите скорую!", "note": "", "cat": "help", "lvl": "A2"},
{"p": "No me encuentro bien.", "t": "Мне нехорошо.", "note": "", "cat": "help", "lvl": "A2"},
{"p": "He perdido el pasaporte.", "t": "Я потерял паспорт.", "note": "", "cat": "help", "lvl": "A2"},
{"p": "¿Dónde está la comisaría?", "t": "Где полицейский участок?", "note": "", "cat": "help", "lvl": "A2"},
{"p": "Es una emergencia.", "t": "Это срочно!", "note": "", "cat": "help", "lvl": "A2"},
{"p": "No funciona el aire acondicionado.", "t": "Не работает кондиционер.", "note": "", "cat": "help", "lvl": "A2"},
{"p": "Me he cortado.", "t": "Я порезался.", "note": "", "cat": "help", "lvl": "A2"},
{"p": "Me han robado la cartera.", "t": "У меня украли кошелёк.", "note": "", "cat": "help", "lvl": "B1"},
{"p": "¿Hay una farmacia de guardia cerca?", "t": "Есть рядом дежурная аптека?", "note": "Испания: аптека, открытая ночью и в выходные.", "cat": "help", "lvl": "B1"},
{"p": "Se me ha roto el móvil.", "t": "У меня сломался телефон.", "note": "Móvil — Испания; в Латинской Америке — celular.", "cat": "help", "lvl": "B1"},

{"p": "¿Diga?", "t": "Алло?", "note": "Испания; в Мексике — ¿Bueno?, в других странах — ¿Aló?", "cat": "phone", "lvl": "A1"},
{"p": "Te llamo luego.", "t": "Перезвоню попозже.", "note": "", "cat": "phone", "lvl": "A1"},
{"p": "¿De parte de quién?", "t": "Как вас представить?", "note": "Вежливо узнать, кто звонит.", "cat": "phone", "lvl": "A2"},
{"p": "¿Está Marta?", "t": "Марту можно?", "note": "", "cat": "phone", "lvl": "A2"},
{"p": "¿Puedo hablar con el señor García?", "t": "Могу я поговорить с сеньором Гарсией?", "note": "Формально.", "cat": "phone", "lvl": "A2"},
{"p": "¿Me oyes? Se corta.", "t": "Слышишь меня? Связь прерывается.", "note": "", "cat": "phone", "lvl": "A2"},
{"p": "No tengo cobertura.", "t": "Не ловит. / Нет связи.", "note": "", "cat": "phone", "lvl": "A2"},
{"p": "Me he quedado sin batería.", "t": "У меня сел телефон.", "note": "", "cat": "phone", "lvl": "A2"},
{"p": "Te mando un wasap.", "t": "Скину тебе в WhatsApp.", "note": "Wasap — разговорное от WhatsApp, очень частое в Испании.", "cat": "phone", "lvl": "A2"},
{"p": "¿Has visto mi mensaje?", "t": "Ты видел моё сообщение?", "note": "", "cat": "phone", "lvl": "A2"},
{"p": "Mándame la ubicación.", "t": "Скинь геолокацию.", "note": "", "cat": "phone", "lvl": "A2"},
{"p": "¿Me pasas tu número?", "t": "Дашь свой номер?", "note": "", "cat": "phone", "lvl": "A2"},
{"p": "Perdone, me he equivocado de número.", "t": "Извините, я ошибся номером.", "note": "", "cat": "phone", "lvl": "A2"},
{"p": "Te he llamado tres veces.", "t": "Я звонил тебе три раза.", "note": "", "cat": "phone", "lvl": "A2"},
{"p": "Luego hablamos.", "t": "Потом созвонимся.", "note": "Значит и «спишемся», и «поговорим при встрече».", "cat": "phone", "lvl": "A2"},
{"p": "Ahora no puede ponerse.", "t": "Он сейчас не может подойти.", "note": "Ponerse (al teléfono) — подойти к телефону.", "cat": "phone", "lvl": "B1"},
{"p": "¿Quiere dejarle un recado?", "t": "Что-нибудь ему передать?", "note": "Формально; recado — устное сообщение для кого-то.", "cat": "phone", "lvl": "B1"},

{"p": "Estudio en la universidad.", "t": "Я учусь в университете.", "note": "", "cat": "work", "lvl": "A1"},
{"p": "Tengo examen mañana.", "t": "У меня завтра экзамен.", "note": "", "cat": "work", "lvl": "A1"},
{"p": "Estoy de vacaciones.", "t": "Я в отпуске.", "note": "", "cat": "work", "lvl": "A1"},
{"p": "Tengo una reunión a las diez.", "t": "У меня совещание в десять.", "note": "", "cat": "work", "lvl": "A2"},
{"p": "¿Me lo puedes mandar por correo?", "t": "Можешь прислать это на почту?", "note": "", "cat": "work", "lvl": "A2"},
{"p": "Estoy buscando trabajo.", "t": "Я ищу работу.", "note": "", "cat": "work", "lvl": "A2"},
{"p": "Hoy me quedo hasta tarde.", "t": "Сегодня задержусь допоздна.", "note": "", "cat": "work", "lvl": "A2"},
{"p": "¿Podemos hablarlo luego?", "t": "Давай обсудим это позже?", "note": "", "cat": "work", "lvl": "A2"},
{"p": "Me tomo un descanso.", "t": "Сделаю перерыв.", "note": "", "cat": "work", "lvl": "A2"},
{"p": "He aprobado.", "t": "Я сдал!", "note": "«Завалил» — he suspendido (Испания).", "cat": "work", "lvl": "A2"},
{"p": "Estoy muy liado.", "t": "Я очень занят. / Я замотался.", "note": "Испания, разговорно. Женщина: liada.", "cat": "work", "lvl": "B1"},
{"p": "Hoy teletrabajo.", "t": "Сегодня работаю из дома.", "note": "Teletrabajar — работать удалённо.", "cat": "work", "lvl": "B1"},
{"p": "¿Cuál es el plazo?", "t": "Какой срок сдачи?", "note": "Plazo — срок, дедлайн.", "cat": "work", "lvl": "B1"},
{"p": "Tengo que entregarlo el lunes.", "t": "Мне надо сдать это в понедельник.", "note": "", "cat": "work", "lvl": "B1"},
{"p": "Lo tengo casi terminado.", "t": "У меня почти готово.", "note": "", "cat": "work", "lvl": "B1"},
{"p": "¿Puedes echarle un vistazo?", "t": "Можешь взглянуть?", "note": "", "cat": "work", "lvl": "B1"},
{"p": "Me han ascendido.", "t": "Меня повысили.", "note": "", "cat": "work", "lvl": "B1"},

{"p": "¡Vale!", "t": "Ладно! / Окей!", "note": "Испания, постоянно; в Латинской Америке — ¡Dale! или ¡Bueno!", "cat": "everyday", "lvl": "A1"},
{"p": "¡Ya voy!", "t": "Иду-иду!", "note": "", "cat": "everyday", "lvl": "A1"},
{"p": "¿En serio?", "t": "Серьёзно?", "note": "", "cat": "everyday", "lvl": "A1"},
{"p": "Ni idea.", "t": "Понятия не имею.", "note": "", "cat": "everyday", "lvl": "A1"},
{"p": "No te preocupes.", "t": "Не переживай.", "note": "", "cat": "everyday", "lvl": "A1"},
{"p": "A ver...", "t": "Так, посмотрим... / Ну-ка...", "note": "Слово-связка, когда думаешь или что-то проверяешь.", "cat": "everyday", "lvl": "A1"},
{"p": "¡Oye!", "t": "Слушай! / Эй!", "note": "Обратиться к знакомому; на «вы» — ¡Oiga!", "cat": "everyday", "lvl": "A1"},
{"p": "¡Venga!", "t": "Давай! / Ну давай!", "note": "Испания: подбодрить, согласиться или попрощаться.", "cat": "everyday", "lvl": "A2"},
{"p": "¡Ya está!", "t": "Готово! / Всё!", "note": "", "cat": "everyday", "lvl": "A2"},
{"p": "Es que no tengo tiempo.", "t": "Просто у меня нет времени.", "note": "Es que... — типичное начало оправдания.", "cat": "everyday", "lvl": "A2"},
{"p": "¡Ya era hora!", "t": "Наконец-то! / Давно пора!", "note": "", "cat": "everyday", "lvl": "A2"},
{"p": "Lo que tú digas.", "t": "Как скажешь.", "note": "", "cat": "everyday", "lvl": "A2"},
{"p": "O sea...", "t": "То есть... / Короче...", "note": "Очень частое слово-паразит.", "cat": "everyday", "lvl": "B1"},
{"p": "¡Ojo!", "t": "Осторожно! / Внимание!", "note": "Букв. «глаз»; предупредить о подвохе.", "cat": "everyday", "lvl": "B1"},
{"p": "Me mola.", "t": "Мне нравится. / Прикольно.", "note": "Испания, сленг.", "cat": "everyday", "lvl": "B1"},
{"p": "¡Qué le vamos a hacer!", "t": "Ну что поделаешь!", "note": "", "cat": "everyday", "lvl": "B1"},
{"p": "Estoy flipando.", "t": "Я в шоке! / Офигеваю!", "note": "Испания, сленг: удивление, и хорошее, и плохое.", "cat": "everyday", "lvl": "B2"},

{"p": "Más vale tarde que nunca.", "t": "Лучше поздно, чем никогда.", "note": "", "cat": "idioms", "lvl": "A2"},
{"p": "Es pan comido.", "t": "Проще простого. / Раз плюнуть.", "note": "Букв. «это съеденный хлеб».", "cat": "idioms", "lvl": "B1"},
{"p": "Estás en las nubes.", "t": "Ты витаешь в облаках.", "note": "", "cat": "idioms", "lvl": "B1"},
{"p": "Me importa un pepino.", "t": "Мне до лампочки.", "note": "Букв. «мне это важно на огурец».", "cat": "idioms", "lvl": "B1"},
{"p": "Me ha costado un ojo de la cara.", "t": "Стоило целое состояние.", "note": "Букв. «стоило мне глаз с лица».", "cat": "idioms", "lvl": "B1"},
{"p": "¿Me estás tomando el pelo?", "t": "Ты надо мной прикалываешься?", "note": "Букв. «ты берёшь меня за волосы?»", "cat": "idioms", "lvl": "B1"},
{"p": "He metido la pata.", "t": "Я облажался. / Я сморозил глупость.", "note": "Букв. «я сунул лапу».", "cat": "idioms", "lvl": "B1"},
{"p": "¡Ponte las pilas!", "t": "Соберись! / Шевелись!", "note": "Букв. «вставь батарейки».", "cat": "idioms", "lvl": "B1"},
{"p": "Has dado en el clavo.", "t": "В точку!", "note": "Букв. «ты попал по гвоздю».", "cat": "idioms", "lvl": "B1"},
{"p": "Estoy hecho polvo.", "t": "Я выжат как лимон.", "note": "Букв. «я превращён в пыль». Женщина: hecha polvo.", "cat": "idioms", "lvl": "B1"},
{"p": "Habla por los codos.", "t": "Болтает без умолку.", "note": "Букв. «говорит локтями».", "cat": "idioms", "lvl": "B1"},
{"p": "Vamos al grano.", "t": "Давай к делу.", "note": "Букв. «пойдём к зерну».", "cat": "idioms", "lvl": "B1"},
{"p": "No hay mal que por bien no venga.", "t": "Нет худа без добра.", "note": "", "cat": "idioms", "lvl": "B1"},
{"p": "Vive en el quinto pino.", "t": "Он живёт у чёрта на куличках.", "note": "Букв. «у пятой сосны»; Испания.", "cat": "idioms", "lvl": "B2"},
{"p": "Son uña y carne.", "t": "Они не разлей вода.", "note": "Букв. «ноготь и плоть».", "cat": "idioms", "lvl": "B2"},
{"p": "No tiene pelos en la lengua.", "t": "Он режет правду-матку.", "note": "Букв. «у него нет волос на языке».", "cat": "idioms", "lvl": "B2"},
{"p": "En boca cerrada no entran moscas.", "t": "Молчание — золото.", "note": "Букв. «в закрытый рот мухи не залетают».", "cat": "idioms", "lvl": "B2"}
]
